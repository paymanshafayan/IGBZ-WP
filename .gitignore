# Dependencies (the plugin ships its own autoloader; nothing here is required to run it)
/vendor/
/node_modules/

# Build output
/dist/
/build/
*.zip

# ...but the offline test environment's WordPress and WooCommerce zips are tracked on purpose.
# The sandbox this is developed in cannot reach wordpress.org and its /tmp is wiped between
# sessions, so these are the only way to rebuild a working site. See _devenv/README.md.
!/_devenv/wordpress-*.zip
!/_devenv/woocommerce-*.zip


# Everything the test environment builds from those zips is disposable.
/_devenv/.work/

# Compiled translations — the .pot is tracked, .mo files are generated
*.mo

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# Local tooling
.phpunit.result.cache
.php-cs-fixer.cache
/phpcs.xml
/.phpcs.xml

# ویرا — وابستگی‌ها، خروجی ساخت، و محیط دورریختنی
vira/node_modules/
vira/dist/
vira/.work/

# اسکیل‌های پروژه
# - اسکیل‌های خودمان (پیشوند igbz-*) در همین پوشه کامیت می‌شوند و ردپای گیت دارند.
# - اسکیل‌های شخص ثالث (دانلودشده از مخازن بیرونی) در زیرپوشهٔ _thirdparty/ قرار
#   می‌گیرند و git-ignored هستند (قابل بازیابی از مخزن مرجع).
/skills/_thirdparty/

# مکان قدیمی (قبل از ۱۴۰۶/۰۵/۳۱: هوشا/پیش از تغییر نام)؛ نگه‌داری‌شده برای سازگاری backward
# اگر کماکان فایلی اینجا بود وارد گیت نشود.
.hoosha/
.hoosha/

# فایل‌های موقت پیش‌نمایش/تست توسعه
_devenv/proxy.mjs
_devenv/test-*.mjs
/preview/
/browser-test/node_modules/

# ---------------------------------------------------------------------------
# _bin/ — باینری‌های آپلودی دستی. این بخش عمداً آخر فایل است: در گیت، آخرین قاعدهٔ
# منطبق برنده است، پس هیچ قاعدهٔ بالاتری (مثل *.zip) نمی‌تواند اینها را دوباره
# نادیده بگیرد. دلیل وجودشان در _bin/README.md آمده.
# ---------------------------------------------------------------------------
!_bin/
!_bin/**
!_bin/*.zip
!_bin/*.rar
!_bin/*.7z
!_bin/*.tar.gz
!_bin/*.tgz
!_bin/*.part-*
!_bin/*.sha256
!_bin/*.[0-9][0-9][0-9]

# آرشیوهای بکاپ هوشا — باینری، محلی، و معادل کامیت 647b5b1
_backup/*.tar.gz
_backup/.last
