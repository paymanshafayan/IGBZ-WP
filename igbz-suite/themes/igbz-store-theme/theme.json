{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "640px",
			"wideSize": "1200px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base",      "color": "#ffffff", "name": "پایه" },
				{ "slug": "base-2",    "color": "#f8f5f0", "name": "پایهٔ گرم" },
				{ "slug": "contrast",  "color": "#1c1917", "name": "متن" },
				{ "slug": "accent",    "color": "#9a3412", "name": "تأکید" },
				{ "slug": "accent-2",  "color": "#f5e6d3", "name": "تأکید روشن" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "Vazirmatn, Vazir, Tahoma, system-ui, sans-serif",
					"slug": "primary",
					"name": "وزیرمتن (محلی)"
				}
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.8"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)",
				"top": "var(--wp--preset--spacing--30)",
				"bottom": "var(--wp--preset--spacing--30)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "سربرگ", "area": "header" },
		{ "name": "footer", "title": "پابرگ", "area": "footer" }
	]
}
